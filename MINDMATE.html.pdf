<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MindMate 2.0 | Early-Warning Mental Health Triage</title>
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Phosphor Icons for smooth aesthetic UI icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            cozy: {
              bg: '#12141a',
              card: '#1a1e28',
              border: '#282f40',
              accent: '#8b5cf6',
              soft: '#a5b4fc'
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Calming Breathing Animation */
    @keyframes breatheAnimation {
      0%, 100% { transform: scale(1); opacity: 0.6; }
      50% { transform: scale(1.6); opacity: 0.95; }
    }
    .animate-breathe {
      animation: breatheAnimation 8s ease-in-out infinite;
    }
  </style>
</head>
<body class="bg-[#0e1117] text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-500 selection:bg-purple-500 selection:text-white">

  <!-- Top Navigation Bar -->
  <header class="border-b border-slate-800 bg-[#151922]/80 backdrop-blur sticky top-0 z-40 px-4 py-3 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-purple-900/30">
        <i class="ph ph-heartbeat text-xl text-white"></i>
      </div>
      <div>
        <h1 class="font-bold text-lg leading-tight tracking-tight flex items-center gap-2">
          MindMate <span class="text-xs bg-purple-500/20 text-purple-300 px-2 py-0.5 rounded-full border border-purple-500/30">2.0 Triage</span>
        </h1>
        <p class="text-xs text-slate-400">Campus Early-Warning & Support</p>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <nav class="hidden md:flex items-center space-x-1 bg-slate-900/60 p-1 rounded-xl border border-slate-800">
      <button onclick="switchTab('vent')" id="tab-vent" class="tab-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-purple-600 text-white shadow-sm">
        <i class="ph ph-chat-teardrop-dots mr-1.5"></i> Daily Vent
      </button>
      <button onclick="switchTab('chill')" id="tab-chill" class="tab-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all text-slate-400 hover:text-white">
        <i class="ph ph-coffee mr-1.5"></i> Chill Zone
      </button>
      <button onclick="switchTab('analytics')" id="tab-analytics" class="tab-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all text-slate-400 hover:text-white">
        <i class="ph ph-plant mr-1.5"></i> Insights & Growth
      </button>
      <button onclick="switchTab('counselor')" id="tab-counselor" class="tab-btn px-4 py-1.5 rounded-lg text-sm font-medium transition-all text-amber-400/90 hover:text-amber-300">
        <i class="ph ph-shield-check mr-1.5"></i> Counselor Portal
      </button>
    </nav>

    <!-- Header Actions (Privacy status & SOS) -->
    <div class="flex items-center space-x-2">
      <!-- Data Lock Badge -->
      <div id="dataLockBadge" class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono" title="Identity Hashed with SHA-256">
        <i class="ph ph-lock-key text-sm"></i>
        <span class="hidden sm:inline" id="lockStatusText">ID: #HASH-839A</span>
      </div>

      <!-- Emergency Break-Glass SOS Button -->
      <button onclick="openSOSModal()" class="bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow-lg shadow-rose-900/40 transition">
        <i class="ph ph-warning-circle text-base animate-pulse"></i>
        <span>SOS</span>
      </button>
    </div>
  </header>

  <!-- Mobile Tab Bar (Bottom) -->
  <div class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-[#151922] border-t border-slate-800 flex justify-around py-2.5 text-xs text-slate-400">
    <button onclick="switchTab('vent')" class="flex flex-col items-center gap-1 focus:text-purple-400">
      <i class="ph ph-chat-teardrop-dots text-lg"></i> Vent
    </button>
    <button onclick="switchTab('chill')" class="flex flex-col items-center gap-1 focus:text-purple-400">
      <i class="ph ph-coffee text-lg"></i> Chill
    </button>
    <button onclick="switchTab('analytics')" class="flex flex-col items-center gap-1 focus:text-purple-400">
      <i class="ph ph-plant text-lg"></i> Growth
    </button>
    <button onclick="switchTab('counselor')" class="flex flex-col items-center gap-1 focus:text-amber-400">
      <i class="ph ph-shield-check text-lg"></i> Portal
    </button>
  </div>

  <!-- Main App Body -->
  <main class="flex-1 max-w-4xl w-full mx-auto p-4 pb-24 md:pb-8 flex flex-col justify-center">

    <!-- 1. VENT SCREEN (DEFAULT) -->
    <section id="screen-vent" class="space-y-6">
      <!-- Dynamic Prompt Banner ("Anti-Survey Approach") -->
      <div class="bg-gradient-to-r from-purple-900/30 via-indigo-900/20 to-slate-900 border border-purple-500/20 rounded-2xl p-4 md:p-5 flex items-start justify-between">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-purple-400" id="prompt-tag">The Battery Check</span>
            <span class="text-xs text-slate-500">• Anti-Survey Mode</span>
          </div>
          <p id="prompt-question" class="text-base md:text-lg font-medium text-slate-200">
            "What drained your battery today, and what recharged it?"
          </p>
        </div>
        <button onclick="rotatePrompt()" class="text-slate-400 hover:text-purple-300 p-2 rounded-lg bg-slate-800/50 hover:bg-slate-800 transition" title="New Prompt">
          <i class="ph ph-arrows-clockwise text-lg"></i>
        </button>
      </div>

      <!-- Emoji Quick-Log Vibe Selector -->
      <div class="bg-[#161a23] border border-slate-800 p-3.5 rounded-xl flex items-center justify-between">
        <span class="text-xs text-slate-400 font-medium">Quick Vibe Check:</span>
        <div class="flex space-x-2">
          <button onclick="selectVibe('🔋 Fully Charged', 'Energy is peak today!')" class="p-2 rounded-lg bg-slate-800/80 hover:bg-purple-600/30 text-xl transition">⚡</button>
          <button onclick="selectVibe('☕ Caffeinated', 'Surviving on coffee and a dream.')" class="p-2 rounded-lg bg-slate-800/80 hover:bg-purple-600/30 text-xl transition">☕</button>
          <button onclick="selectVibe('🫠 Melting Down', 'Everything is happening all at once.')" class="p-2 rounded-lg bg-slate-800/80 hover:bg-purple-600/30 text-xl transition">🫠</button>
          <button onclick="selectVibe('🪫 Dead Battery', 'Zero fuel left in the tank.')" class="p-2 rounded-lg bg-slate-800/80 hover:bg-purple-600/30 text-xl transition">🪫</button>
          <button onclick="selectVibe('🌧️ In the Clouds', 'Dissociating and overthinking.')" class="p-2 rounded-lg bg-slate-800/80 hover:bg-purple-600/30 text-xl transition">🌧️</button>
        </div>
      </div>

      <!-- Micro-Journaling Venting Box -->
      <div class="bg-[#161a23] border border-slate-800 rounded-2xl p-4 relative shadow-xl">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-xs text-slate-400">Anonymous Channel (AI Triage Ready)</span>
          </div>
          <!-- Unmask Me feature -->
          <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-400 hover:text-slate-200">
            <input type="checkbox" id="unmaskToggle" onchange="toggleUnmask()" class="rounded border-slate-700 text-purple-600 focus:ring-0">
            <span>Unmask Me (Request Counselor)</span>
          </label>
        </div>

        <textarea
          id="journalInput"
          maxlength="280"
          oninput="updateCharCount()"
          rows="4"
          placeholder="Vent it out... Got too many tabs open in your brain? Type or hold microphone (Max 280 chars)."
          class="w-full bg-transparent border-0 text-slate-200 placeholder-slate-500 focus:ring-0 resize-none text-base leading-relaxed"
        ></textarea>

        <!-- Bottom Tools (Voice, Counter, Submit) -->
        <div class="flex items-center justify-between pt-3 border-t border-slate-800/80">
          <div class="flex items-center space-x-2">
            <!-- Voice to text button -->
            <button
              id="voiceBtn"
              onclick="toggleSpeechRecognition()"
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-purple-600/20 text-slate-300 hover:text-purple-300 border border-slate-700 text-xs transition"
            >
              <i class="ph ph-microphone text-base" id="micIcon"></i>
              <span id="micText">Hold / Tap to Speak</span>
            </button>
            <span id="speechIndicator" class="hidden text-xs text-purple-400 animate-pulse font-mono">Listening...</span>
          </div>

          <div class="flex items-center space-x-3">
            <span id="charCount" class="text-xs font-mono text-slate-500">0 / 280</span>
            <button
              onclick="processTriage()"
              class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-medium text-xs px-4 py-2 rounded-lg flex items-center gap-1.5 shadow-md transition"
            >
              <span>Send</span>
              <i class="ph ph-paper-plane-right"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Real-time AI Triage Simulator Feedback -->
      <div id="triageResultBox" class="hidden rounded-xl border p-4 transition-all duration-300">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-2">
            <div id="triageIcon" class="p-2 rounded-lg"></div>
            <div>
              <h3 id="triageTitle" class="text-sm font-bold"></h3>
              <p id="triageSubtitle" class="text-xs text-slate-400"></p>
            </div>
          </div>
          <span id="triageScoreTag" class="text-xs font-mono px-2 py-0.5 rounded border"></span>
        </div>
        <div id="triageActionContent" class="mt-3 text-xs leading-relaxed text-slate-300 pt-2 border-t border-slate-800"></div>
      </div>
    </section>

    <!-- 2. CHILL ZONE TAB -->
    <section id="screen-chill" class="hidden space-y-6">
      <div class="text-center space-y-1">
        <h2 class="text-xl font-bold text-white">The Chill Zone</h2>
        <p class="text-xs text-slate-400">Micro-tools for quick decompression & focus.</p>
      </div>

      <!-- Interactive Breathing Visualizer -->
      <div class="bg-[#161a23] border border-slate-800 rounded-2xl p-8 flex flex-col items-center justify-center relative overflow-hidden">
        <div class="text-center mb-6">
          <h3 class="text-sm font-semibold text-purple-300">4-7-8 Breathing Anchor</h3>
          <p class="text-xs text-slate-400" id="breatheText">Breathe in as the circle expands... Breathe out as it contracts</p>
        </div>

        <!-- Animated Bubble -->
        <div class="relative w-48 h-48 flex items-center justify-center my-4">
          <div class="absolute inset-0 bg-purple-600/20 rounded-full blur-xl"></div>
          <div class="w-28 h-28 bg-gradient-to-tr from-purple-500 to-indigo-400 rounded-full animate-breathe flex items-center justify-center shadow-2xl shadow-indigo-500/50">
            <i class="ph ph-wind text-2xl text-white"></i>
          </div>
        </div>
      </div>

      <!-- Quick Action Cards (Pomodoro, Lo-Fi, Grounding) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="bg-[#161a23] border border-slate-800 p-4 rounded-xl space-y-2 hover:border-purple-500/40 transition">
          <div class="w-8 h-8 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center">
            <i class="ph ph-timer text-lg"></i>
          </div>
          <h4 class="text-sm font-semibold">5-Min Focus Reset</h4>
          <p class="text-xs text-slate-400">Clear exam mental fog with quick Pomodoro sprints.</p>
          <button onclick="alert('Starting 5-minute study sprint timer!')" class="text-xs text-purple-400 hover:text-purple-300 font-medium">Start Timer →</button>
        </div>

        <div class="bg-[#161a23] border border-slate-800 p-4 rounded-xl space-y-2 hover:border-purple-500/40 transition">
          <div class="w-8 h-8 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center">
            <i class="ph ph-headphones text-lg"></i>
          </div>
          <h4 class="text-sm font-semibold">Curated Lo-Fi Playlist</h4>
          <p class="text-xs text-slate-400">Calm, beat-driven ambient audio for study pressure.</p>
          <a href="https://open.spotify.com" target="_blank" class="inline-block text-xs text-purple-400 hover:text-purple-300 font-medium">Open Lo-Fi Stream →</a>
        </div>

        <div class="bg-[#161a23] border border-slate-800 p-4 rounded-xl space-y-2 hover:border-purple-500/40 transition">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
            <i class="ph ph-hand-palm text-lg"></i>
          </div>
          <h4 class="text-sm font-semibold">5-4-3-2-1 Grounding</h4>
          <p class="text-xs text-slate-400">Notice 5 things you can see, 4 you can touch...</p>
          <button onclick="alert('5 Things you see\n4 Things you feel\n3 Things you hear\n2 Things you smell\n1 Thing you taste')" class="text-xs text-purple-400 hover:text-purple-300 font-medium">Launch Exercise →</button>
        </div>
      </div>
    </section>

    <!-- 3. ANALYTICS & FORGIVING STREAKS TAB -->
    <section id="screen-analytics" class="hidden space-y-6">
      <div class="text-center space-y-1">
        <h2 class="text-xl font-bold text-white">Your Personal Insights</h2>
        <p class="text-xs text-slate-400">Zero-guilt tracking. Missing a day never resets your streak to zero.</p>
      </div>

      <!-- Growth Plant Streak (Guilt-Free) -->
      <div class="bg-[#161a23] border border-slate-800 rounded-2xl p-5 flex items-center justify-between">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wide">Consistency Bonsai</span>
            <span class="bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 text-[10px] px-2 py-0.5 rounded-full">Forgiving Streak</span>
          </div>
          <p class="text-lg font-bold text-white">Level 4 Mindful Sprout 🌱</p>
          <p class="text-xs text-slate-400 max-w-sm">You've checked in 12 days this month. Even when you miss a day, your plant retains its health.</p>
        </div>
        <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-3xl">
          🪴
        </div>
      </div>

      <!-- Mood Heatmap Simulation -->
      <div class="bg-[#161a23] border border-slate-800 rounded-2xl p-5 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-semibold">Monthly Mood Flow</h3>
          <span class="text-xs text-slate-500">September 2026</span>
        </div>
        <div class="grid grid-cols-7 gap-1.5 text-center text-[10px] text-slate-500 font-mono">
          <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
        </div>
        <div class="grid grid-cols-7 gap-1.5" id="heatmapGrid">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Spotify-Wrapped Style Insight -->
      <div class="bg-gradient-to-r from-purple-900/40 via-indigo-950 to-slate-900 border border-purple-500/30 rounded-2xl p-5 flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center shrink-0">
          <i class="ph ph-sparkle text-2xl"></i>
        </div>
        <div class="space-y-0.5">
          <h4 class="text-sm font-bold text-purple-200">Wrapped Insight: The "Tuesday Slump"</h4>
          <p class="text-xs text-slate-300">
            "You tend to log lower energy on Tuesday afternoons after your back-to-back labs. Maybe schedule a walk or skip the extra espresso then!"
          </p>
        </div>
      </div>
    </section>

    <!-- 4. COUNSELOR DASHBOARD PORTAL (AI ROUTED MODERATE RISK) -->
    <section id="screen-counselor" class="hidden space-y-6">
      <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="p-2 bg-amber-500/20 text-amber-300 rounded-xl">
            <i class="ph ph-shield-warning text-2xl"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-amber-200">Campus Clinician Triage Portal</h2>
            <p class="text-xs text-slate-400">Moderate-risk logs queued for human review. Identities remain hashed until outreach is approved.</p>
          </div>
        </div>
        <span class="text-xs bg-amber-500/20 text-amber-300 font-mono px-2.5 py-1 rounded-lg border border-amber-500/30">
          Pending: <span id="queueCount">1</span>
        </span>
      </div>

      <!-- Counselor Review Queue -->
      <div id="counselorQueue" class="space-y-3">
        <!-- Sample Moderate Card -->
        <div class="bg-[#161a23] border border-amber-500/30 rounded-xl p-4 space-y-3" id="sampleReviewCard">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700">Hash: #STU-9941</span>
              <span class="text-xs bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded border border-amber-500/30 font-semibold">Moderate Risk (Score: 68/100)</span>
            </div>
            <span class="text-[11px] text-slate-500">14 mins ago</span>
          </div>

          <p class="text-xs text-slate-200 leading-relaxed bg-slate-900/60 p-3 rounded-lg border border-slate-800">
            "Haven't left my dorm room in 4 days. Skipped all my morning seminars and honestly don't feel like talking to anyone in my cohort."
          </p>

          <div class="flex items-center justify-between pt-2 border-t border-slate-800 text-xs">
            <div class="text-slate-400">
              Trigger words: <span class="text-amber-400">prolonged isolation, missed class, withdrawal</span>
            </div>
            <div class="flex space-x-2">
              <button onclick="dismissCard('sampleReviewCard')" class="px-3 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition">
                Ignore / False Flag
              </button>
              <button onclick="approveOutreach('sampleReviewCard', '#STU-9941')" class="px-3 py-1 rounded bg-amber-600 hover:bg-amber-500 text-white font-medium shadow transition">
                Approve Outreach
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- SOS / BREAK GLASS MODAL -->
  <div id="sosModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#1a1418] border-2 border-rose-600/80 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center space-x-3 text-rose-500">
        <i class="ph ph-warning-octagon text-3xl animate-bounce"></i>
        <div>
          <h3 class="font-bold text-lg text-white">Emergency Support (Break-Glass)</h3>
          <p class="text-xs text-rose-300/80">Direct bypass: AI is disabled for this channel.</p>
        </div>
      </div>
      <p class="text-xs text-slate-300 leading-relaxed">
        If you are experiencing immediate crisis, thoughts of self-harm, or feel unsafe, please connect with real human support right now.
      </p>

      <div class="space-y-2 pt-2">
        <a href="tel:988" class="flex items-center justify-between p-3 rounded-xl bg-rose-600/20 border border-rose-500/40 hover:bg-rose-600/30 text-rose-200 transition">
          <div>
            <div class="font-bold text-xs">Suicide & Crisis Lifeline</div>
            <div class="text-[11px] text-slate-400">Call or Text 24/7 (Free & Confidential)</div>
          </div>
          <span class="font-mono text-sm font-bold bg-rose-600 px-2 py-1 rounded text-white">988</span>
        </a>

        <a href="tel:911" class="flex items-center justify-between p-3 rounded-xl bg-slate-800/80 border border-slate-700 hover:bg-slate-800 text-slate-200 transition">
          <div>
            <div class="font-bold text-xs">Campus Crisis Security</div>
            <div class="text-[11px] text-slate-400">Immediate on-campus response</div>
          </div>
          <span class="font-mono text-sm font-bold bg-slate-700 px-2 py-1 rounded text-white">Ext. 5555</span>
        </a>
      </div>

      <div class="flex justify-end pt-2">
        <button onclick="closeSOSModal()" class="px-4 py-1.5 text-xs text-slate-400 hover:text-white transition">
          Close Window
        </button>
      </div>
    </div>
  </div>

  <!-- JAVASCRIPT LOGIC -->
  <script>
    // 1. DYNAMIC PROMPT SYSTEM ("Anti-Survey" Approach)
    const prompts = [
      { tag: "The Battery Check", text: "What drained your battery today, and what recharged it?" },
      { tag: "The Brain Dump", text: "Got a lot of tabs open in your brain right now? Vent it all out here, no filter needed." },
      { tag: "The Time Machine", text: "If you could skip one class or event this week, what would it be and why?" },
      { tag: "The Pop Culture Prompt", text: "If your current mood was a movie genre or a video game, what would it be right now?" },
      { tag: "The Grateful / Grumble", text: "Name one thing that went perfectly today, and one thing that was incredibly annoying." }
    ];
    let promptIndex = 0;

    function rotatePrompt() {
      promptIndex = (promptIndex + 1) % prompts.length;
      document.getElementById('prompt-tag').innerText = prompts[promptIndex].tag;
      document.getElementById('prompt-question').innerText = `"${prompts[promptIndex].text}"`;
    }

    // 2. EMOJI QUICK-LOG
    function selectVibe(vibe, desc) {
      const input = document.getElementById('journalInput');
      input.value = `[Vibe: ${vibe}] - ${desc} `;
      updateCharCount();
      input.focus();
    }

    // 3. CHARACTER COUNT
    function updateCharCount() {
      const len = document.getElementById('journalInput').value.length;
      document.getElementById('charCount').innerText = `${len} / 280`;
    }

    // 4. TAB NAVIGATION
    function switchTab(tab) {
      const screens = ['vent', 'chill', 'analytics', 'counselor'];
      screens.forEach(s => {
        document.getElementById(`screen-${s}`).classList.add('hidden');
        const btn = document.getElementById(`tab-${s}`);
        if (btn) {
          btn.classList.remove('bg-purple-600', 'text-white', 'shadow-sm');
          btn.classList.add('text-slate-400');
        }
      });

      document.getElementById(`screen-${tab}`).classList.remove('hidden');
      const activeBtn = document.getElementById(`tab-${tab}`);
      if (activeBtn) {
        activeBtn.classList.add('bg-purple-600', 'text-white', 'shadow-sm');
        activeBtn.classList.remove('text-slate-400');
      }
    }

    // 5. UNMASK ME TOGGLE
    function toggleUnmask() {
      const checked = document.getElementById('unmaskToggle').checked;
      const badge = document.getElementById('dataLockBadge');
      const text = document.getElementById('lockStatusText');

      if (checked) {
        badge.className = "flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-mono";
        text.innerText = "UNMASKED: John Doe (#2026-CS)";
      } else {
        badge.className = "flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono";
        text.innerText = "ID: #HASH-839A";
      }
    }

    // 6. VOICE-TO-TEXT INTEGRATION (Web Speech API)
    let recognition;
    let isRecording = false;

    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = false;

      recognition.onstart = () => {
        isRecording = true;
        document.getElementById('micText').innerText = "Listening...";
        document.getElementById('speechIndicator').classList.remove('hidden');
        document.getElementById('micIcon').className = "ph ph-waveform text-base text-rose-400 animate-pulse";
      };

      recognition.onresult = (e) => {
        const transcript = e.results[0][0].transcript;
        const input = document.getElementById('journalInput');
        input.value += (input.value ? " " : "") + transcript;
        updateCharCount();
      };

      recognition.onend = () => {
        isRecording = false;
        document.getElementById('micText').innerText = "Hold / Tap to Speak";
        document.getElementById('speechIndicator').classList.add('hidden');
        document.getElementById('micIcon').className = "ph ph-microphone text-base";
      };

      recognition.onerror = () => {
        recognition.stop();
      };
    }

    function toggleSpeechRecognition() {
      if (!recognition) {
        alert("Speech recognition is not supported in this browser. Please type in your vent!");
        return;
      }
      if (isRecording) {
        recognition.stop();
      } else {
        recognition.start();
      }
    }

    // 7. AI ROUTING / TRIAGE CONTROLLER SIMULATION
    function processTriage() {
      const text = document.getElementById('journalInput').value.trim();
      if (!text) {
        alert("Please write or speak something before sending.");
        return;
      }

      const lower = text.toLowerCase();
      const resultBox = document.getElementById('triageResultBox');
      const triageIcon = document.getElementById('triageIcon');
      const triageTitle = document.getElementById('triageTitle');
      const triageSubtitle = document.getElementById('triageSubtitle');
      const triageScoreTag = document.getElementById('triageScoreTag');
      const triageActionContent = document.getElementById('triageActionContent');

      resultBox.classList.remove('hidden');

      // HIGH RISK KEYWORDS (Triggers Break-Glass alert)
      const highKeywords = ['suicide', 'kill myself', 'end it all', 'die', 'hurt myself', 'hang myself'];
      const isHigh = highKeywords.some(w => lower.includes(w));

      // MODERATE RISK KEYWORDS (Routes to Counselor Dashboard)
      const modKeywords = ['hopeless', 'isolate', 'depressed', 'can\'t go on', 'cant do this anymore', 'worthless', 'giving up', 'crying all day'];
      const isMod = modKeywords.some(w => lower.includes(w));

      const isUnmasked = document.getElementById('unmaskToggle').checked;

      if (isHigh) {
        // Triage High Scenario
        resultBox.className = "rounded-xl border border-rose-500/50 bg-rose-950/30 p-4 transition-all";
        triageIcon.className = "p-2 rounded-lg bg-rose-600/30 text-rose-300";
        triageIcon.innerHTML = `<i class="ph ph-warning-octagon text-2xl"></i>`;
        triageTitle.innerText = "CRITICAL: High-Risk Safety Override Triggered";
        triageTitle.className = "text-sm font-bold text-rose-200";
        triageSubtitle.innerText = "System bypassed queue and sent high-priority alert to Campus Crisis Team.";
        triageScoreTag.className = "text-xs font-mono px-2 py-0.5 rounded border border-rose-500/40 bg-rose-600/20 text-rose-300";
        triageScoreTag.innerText = "Score: 95/100 (HIGH RISK)";
        triageActionContent.innerHTML = `
          <strong>Action Executed:</strong> Anonymization rules bypassed. Direct ping dispatched to Crisis Response Unit with geolocation and log snippet. Please speak with someone immediately.
          <div class="mt-2"><button onclick="openSOSModal()" class="bg-rose-600 text-white px-3 py-1 rounded text-xs font-semibold">Open Emergency Hotline</button></div>
        `;
        openSOSModal();
      } else if (isMod || isUnmasked) {
        // Triage Moderate Scenario
        resultBox.className = "rounded-xl border border-amber-500/50 bg-amber-950/20 p-4 transition-all";
        triageIcon.className = "p-2 rounded-lg bg-amber-600/30 text-amber-300";
        triageIcon.innerHTML = `<i class="ph ph-user-circle-gear text-2xl"></i>`;
        triageTitle.innerText = isUnmasked ? "Dispatched: Unmask Request Received" : "Moderate Risk Flagged: Queued for Clinician Review";
        triageTitle.className = "text-sm font-bold text-amber-200";
        triageSubtitle.innerText = "Text snippet securely delivered to Campus Counselor Dashboard.";
        triageScoreTag.className = "text-xs font-mono px-2 py-0.5 rounded border border-amber-500/40 bg-amber-600/20 text-amber-300";
        triageScoreTag.innerText = "Score: 62/100 (MODERATE)";
        triageActionContent.innerHTML = `
          <strong>Action Executed:</strong> Sent to human counselor triage queue. If approved by counselor, an invite for a walk-in chat will be dispatched to your student email.
        `;
        // Append card to counselor queue
        addCardToCounselorQueue(text, isUnmasked ? "John Doe (Unmasked)" : "#HASH-839A");
      } else {
        // Triage Low Scenario (Automated End-Task)
        resultBox.className = "rounded-xl border border-purple-500/40 bg-purple-950/20 p-4 transition-all";
        triageIcon.className = "p-2 rounded-lg bg-purple-600/30 text-purple-300";
        triageIcon.innerHTML = `<i class="ph ph-sparkle text-2xl"></i>`;
        triageTitle.innerText = "Low Risk: Autonomous Wellness Nudge Activated";
        triageTitle.className = "text-sm font-bold text-purple-200";
        triageSubtitle.innerText = "No counselor required. Handled 100% autonomously by MindMate.";
        triageScoreTag.className = "text-xs font-mono px-2 py-0.5 rounded border border-purple-500/40 bg-purple-600/20 text-purple-300";
        triageScoreTag.innerText = "Score: 18/100 (LOW)";
        triageActionContent.innerHTML = `
          <strong>Suggested Resource:</strong> We noticed signs of normal exam/daily fatigue. Head to the 
          <a href="javascript:switchTab('chill')" class="text-purple-400 underline font-semibold">Chill Zone</a> 
          for a 5-minute breathing session and study lo-fi beats.
        `;
      }
    }

    // 8. COUNSELOR QUEUE HELPER
    function addCardToCounselorQueue(snippet, idName) {
      const container = document.getElementById('counselorQueue');
      const cardId = 'card-' + Date.now();
      const card = document.createElement('div');
      card.id = cardId;
      card.className = "bg-[#161a23] border border-amber-500/30 rounded-xl p-4 space-y-3";
      card.innerHTML = `
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700">${idName}</span>
            <span class="text-xs bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded border border-amber-500/30 font-semibold">Moderate Risk</span>
          </div>
          <span class="text-[11px] text-slate-500">Just now</span>
        </div>
        <p class="text-xs text-slate-200 leading-relaxed bg-slate-900/60 p-3 rounded-lg border border-slate-800">
          "${snippet}"
        </p>
        <div class="flex items-center justify-between pt-2 border-t border-slate-800 text-xs">
          <div class="text-slate-400">Status: <span class="text-amber-400">Awaiting Decision</span></div>
          <div class="flex space-x-2">
            <button onclick="dismissCard('${cardId}')" class="px-3 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition">Ignore</button>
            <button onclick="approveOutreach('${cardId}', '${idName}')" class="px-3 py-1 rounded bg-amber-600 hover:bg-amber-500 text-white font-medium shadow transition">Approve Outreach</button>
          </div>
        </div>
      `;
      container.prepend(card);
      updateQueueCount(1);
    }

    function dismissCard(cardId) {
      const card = document.getElementById(cardId);
      if (card) {
        card.remove();
        updateQueueCount(-1);
      }
    }

    function approveOutreach(cardId, idName) {
      alert(`Outreach Approved for ${idName}!\nSystem un-hashed the contact and sent a gentle message: "Hey, just checking in. We have walk-in slots open today if you'd like to chat."`);
      dismissCard(cardId);
    }

    function updateQueueCount(diff) {
      const badge = document.getElementById('queueCount');
      let current = parseInt(badge.innerText) || 0;
      current = Math.max(0, current + diff);
      badge.innerText = current;
    }

    // 9. MODAL CONTROLS
    function openSOSModal() {
      document.getElementById('sosModal').classList.remove('hidden');
    }
    function closeSOSModal() {
      document.getElementById('sosModal').classList.add('hidden');
    }

    // 10. GENERATE MOOD HEATMAP DUMMY DATA
    const heatmapGrid = document.getElementById('heatmapGrid');
    const moodColors = [
      'bg-slate-800',
      'bg-purple-900/50',
      'bg-purple-700/60',
      'bg-indigo-600/70',
      'bg-emerald-500/80'
    ];
    for (let i = 1; i <= 28; i++) {
      const cell = document.createElement('div');
      const randomColor = moodColors[Math.floor(Math.random() * moodColors.length)];
      cell.className = `h-8 rounded-lg ${randomColor} flex items-center justify-center text-[10px] text-slate-400/80 border border-slate-800 hover:border-purple-400 cursor-pointer transition`;
      cell.title = `Day ${i}: Logged`;
      cell.innerText = i;
      heatmapGrid.appendChild(cell);
    }
  </script>
</body>
</html>